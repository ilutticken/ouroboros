.vite/
.vitest/
coverage/
*.tsbuildinfo

# Logs & debug output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Local env
.env
.env.local
